{
  "name": "backend-realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de tiempo real del Salón de Estudio Colaborativo (Mini-proyecto 2). Socket.io + TypeScript + Firestore.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^14.0.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
